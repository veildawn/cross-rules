# =============================================
# 规则说明:
# - DOMAIN-SUFFIX: 匹配域名后缀
# - DOMAIN: 精确匹配完整域名
#
# 使用方式 (在 mihomo 配置中):
# rule-providers:
#   ai:
#     type: http
#     behavior: classical
#     url: "https://raw.githubusercontent.com/Ashbaer/cross-rules/main/mihomo/ai.list"
#     path: ./ruleset/ai.list
#     interval: 86400
#
# rules:
#   - RULE-SET,ai,代理策略组
# =============================================
